# web_auth_admin_key(<config> <tag>): for the calling component (firmware/*/main),
# generate admin_hash.h in its build dir and add that dir to its include path:
#   ADMIN_KEY        PBKDF2-HMAC-SHA256(CONFIG_<config>, ADMIN_SALT, ADMIN_ITERATIONS),
#                    the HMAC key of the page's signed admin requests (32 bytes)
#   ADMIN_SALT       "fpv58-checkpoint/<tag>/" + 16 hex chars, random at each configure,
#                    so no precomputed table fits two builds
#   ADMIN_ITERATIONS 200000: about 0.1 s on a desktop browser, 0.3-1 s on a phone,
#                    once per login (the ESP never runs the derivation)
#   ADMIN_AUTH_OPEN  1 for an empty password: admin auth disabled
# The password itself never enters the firmware nor a command line: admin_key.py
# reads it from the build's sdkconfig.json. Call it outside CMAKE_BUILD_EARLY_EXPANSION
# (this file is not included in that script-mode pass).
function(web_auth_admin_key config tag)
    set(iterations 200000)
    idf_build_get_property(python PYTHON)
    idf_build_get_property(sdkconfig_json SDKCONFIG_JSON)
    idf_component_get_property(dir web_auth COMPONENT_DIR)
    string(RANDOM LENGTH 16 ALPHABET "0123456789abcdef" rnd)
    set(admin_salt "fpv58-checkpoint/${tag}/${rnd}")
    execute_process(COMMAND "${python}" "${dir}/admin_key.py" "${sdkconfig_json}" "${config}"
                            "${admin_salt}" "${iterations}"
                    OUTPUT_VARIABLE key_hex OUTPUT_STRIP_TRAILING_WHITESPACE
                    RESULT_VARIABLE rc)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "web_auth: cannot derive the admin key from CONFIG_${config}")
    endif()
    if(key_hex STREQUAL "")
        set(admin_open 1)
        string(REPEAT "00" 32 key_hex)
    else()
        set(admin_open 0)
    endif()
    string(REGEX REPLACE "(..)" "0x\\1, " admin_key "${key_hex}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dir}/admin_key.py")
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/admin_hash.h" @ONLY CONTENT [=[
/* Generated by web_auth_admin_key() (components/web_auth/project_include.cmake)
 * from CONFIG_@config@; do not edit. */
#pragma once
#define ADMIN_AUTH_OPEN @admin_open@   /* 1: empty password, admin auth disabled */
#define ADMIN_SALT "@admin_salt@"
#define ADMIN_ITERATIONS @iterations@
#define ADMIN_KEY { @admin_key@}   /* PBKDF2-HMAC-SHA256(password, salt, iterations) */
]=])
    target_include_directories(${COMPONENT_LIB} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
endfunction()
