# The scan loop's library code in IRAM (ESP32-C5): libm helpers the DSP and
# metrics call per hop, and the PHY functions of the PLL-only retune
# (radio_c5.c, pll_retune). From flash, their cache misses made the hop time
# move with the build's code placement. Our own scan-loop functions are
# IRAM_ATTR in the sources.
# GPL-3.0-or-later.
# SPDX-License-Identifier: GPL-3.0-or-later
# Ported to FPV 5.8 Checkpoint from widscan58 by CapnBry (https://github.com/CapnBry/widscan58),
# commit a9fff97, firmware/src/radio/c5/hot_iram.lf.
# Changes for FPV 5.8 Checkpoint: adapted for IDF 6.0.2, which links picolibc: widscan58's newlib
# libm/libc object names do not exist there, so only the three libm objects the hop calls are
# mapped, by their picolibc names (sdr_libm); phy_force_rx_gain (the gain force) and
# phy_freq_band_reg_set/phy_vht_support (reached by the PLL-only retune via phy_freq_set_reg and
# phy_bb_cfo_cfg) added; the ringbuf/FreeRTOS "cold" mappings left out (spec 3.7 fallback 2);
# fragment names sdr_*. libphy is a prebuilt archive: its function
# sections are named. Our own hot functions are IRAM_ATTR in the sources (sdr_radio_c5.c,
# sdr_recal_c5.c, sdr_psd.c, fft_r4_sc16.h, sdr_level.c, sdr_rx.c).
# This file keeps its GPL-3.0-or-later notice; the repository as a whole is GPL-3.0-only.

# libphy.a is linked by name (-lphy), so ldgen does not read it and cannot
# map single functions of it; its function sections are named instead.
[sections:sdr_phy_hot]
entries:
    .text.phy_set_channel_rfpll_freq_new
    .text.phy_set_rf_freq_offset
    .text.phy_set_rfpll_freq
    .text.phy_rfpll_set_freq
    .text.phy_write_rfpll_sdm
    .text.phy_restart_cal
    .text.phy_wait_rfpll_cal_end_new
    .text.phy_rfpll_set_adc_rate
    .text.phy_set_freq_i2c_new
    .text.phy_get_vco_init_new
    .text.phy_get_i2c_hostid_
    .text.phy_get_i2c_read_mask_
    .text.phy_freq_mem_change_5g_
    .text.phy_wr_freq_mem
    .text.phy_freq_mem_data
    .text.phy_freq_i2c_mem_write
    .text.phy_band_change
    .text.phy_band_reg
    .text.phy_tatget_pwr_band
    .text.phy_set_rx_pbus_freq
    .text.phy_set_pbus_mem
    .text.phy_set_pbus_mem_5g
    .text.phy_write_pbus_mem
    .text.phy_pbus_reg_store
    .text.phy_xtal_duty_set
    .text.phy_get_xtal_duty
    .text.phy_write_gain_mem
    .text.phy_rx_filter_mode
    .text.phy_abs_temp
    .text.phy_force_rx_gain
    .text.phy_freq_band_reg_set
    .text.phy_vht_support

[scheme:sdr_phy_hot]
entries:
    sdr_phy_hot -> iram0_text

[mapping:sdr_phy]
archive: libphy.a
entries:
    * (sdr_phy_hot)

[mapping:sdr_esp_phy]
archive: libesp_phy.a
entries:
    phy_init:phy_get_lock (noflash)

# The libm the hop calls once per capture (sqrtf, lrintf, ldexpf -> scalbnf), by picolibc object
# name (IDF's convention, esp_libc/src/picolibc/libc.lf).
[mapping:sdr_libm]
archive: libc.a
entries:
    libm_machine_riscv_sf_sqrt (noflash)
    libm_machine_riscv_sf_lrint (noflash)
    libm_common_sf_scalbn (noflash)
