menu "Checkpoint antenna"

    config CHECKPOINT_ANTENNA_IPEX
        bool "Boot on the IPEX antenna (Waveshare ESP32-C5-Zero only)"
        default n
        help
            Drives GPIO 26 high before the radio starts: on the C5-Zero it is the
            antenna switch, high for the IPEX connector, low for the onboard
            antenna. Off, the firmware leaves GPIO 26 alone and the board stays on
            its default, the onboard antenna. Only for a C5-Zero: GPIO 26 is
            something else, or nothing, on other boards. On the bench, K then i
            switches the antenna at run time. A boot with nothing on the IPEX
            connector is deaf; recalibrate (B, VTX off) after changing antenna.

endmenu

menu "Checkpoint C5<->C3 link"

    config CHECKPOINT_LINK_ENABLE
        bool "Enable the UART link to the C3 config/telemetry bridge"
        default y
        help
            Report pass events and stats to, and accept detector configuration
            from, the bridge (a C3 node or the C6 master) over UART. With it
            off, passes appear only as PASS lines on the console, which is then
            the only way to tune the detector (it has no local output).

    config CHECKPOINT_LINK_UART_NUM
        int "UART controller number"
        depends on CHECKPOINT_LINK_ENABLE
        default 1
        range 0 1
        help
            The console is on USB-Serial-JTAG, so UART1 (or UART0) is free.

    config CHECKPOINT_LINK_TX_GPIO
        int "Link UART TX GPIO (to the C3 RX)"
        depends on CHECKPOINT_LINK_ENABLE
        default 6
        help
            GPIO 6 (TX) and 8 (RX) are receiver-free header pins on the
            C5-Zero (GPIO 15 is not broken out). GPIO 8 is a video-DAC pin,
            free with video off. See the GPIO map in CLAUDE.md.

    config CHECKPOINT_LINK_RX_GPIO
        int "Link UART RX GPIO (from the C3 TX)"
        depends on CHECKPOINT_LINK_ENABLE
        default 8

    config CHECKPOINT_LINK_BAUD
        int "Link UART baud rate"
        depends on CHECKPOINT_LINK_ENABLE
        default 115200

    config CHECKPOINT_LINK_STATS_MS
        int "Stats report period (ms)"
        depends on CHECKPOINT_LINK_ENABLE
        default 1000

endmenu
