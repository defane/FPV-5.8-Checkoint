menu "Checkpoint C3 bridge"

    config C3_UART_NUM
        int "Link UART controller number"
        default 1
        range 0 1

    config C3_UART_TX_GPIO
        int "Link UART TX GPIO (to the C5 RX, GPIO 8)"
        default 5

    config C3_UART_RX_GPIO
        int "Link UART RX GPIO (from the C5 TX, GPIO 6)"
        default 4

    config C3_UART_BAUD
        int "Link UART baud rate (must match the C5)"
        default 115200

    config C3_AP_SSID
        string "Wi-Fi SoftAP SSID"
        default "checkpoint-c3"

    config C3_AP_PASSWORD
        string "Wi-Fi SoftAP password (8 to 63 chars, empty = open)"
        default "dronepass"

    config C3_AP_CHANNEL
        int "Wi-Fi AP / ESP-NOW channel (must match the C6 master)"
        default 1
        range 1 13

    config C3_FLEET_TIMEOUT_MS
        int "Boot: wait this long for the C6 before degraded mode (ms)"
        default 8000

    comment "Degraded web: spectators read results; changing the band needs this password."
    config C3_ADMIN_PASSWORD
        string "Degraded-web admin password (128 bytes max, empty disables admin auth)"
        default "checkpoint"

endmenu
