# Checkpoint C3 bridge: UART to the C5, Wi-Fi SoftAP and a small web UI.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The web UI serves a single embedded page plus two small JSON endpoints.
CONFIG_HTTPD_MAX_URI_LEN=128

# Status LED: onboard WS2812 of the Waveshare C3-Zero is on GPIO10.
CONFIG_STATUS_LED_GPIO=10
