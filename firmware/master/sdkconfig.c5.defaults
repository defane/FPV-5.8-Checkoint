# Temporary "C5 as master" build: run the C6 master firmware on an ESP32-C5
# board while the real C6 is unavailable. There is no receiver here, but on the
# C5 GPIO 16-22 are the SPI flash, so the amplifier cannot use the C6 defaults
# (18-21). It moves to the proven C5 amp pins (BCLK 9 / LRC 8 / DIN 7 / SD 10;
# SD stays off GPIO7, a strapping pin). UART to the gate C5 keeps 4/5.
#
# Build (standalone defaults, own build dir):
#   idf.py -DSDKCONFIG_DEFAULTS=sdkconfig.c5.defaults -B build-c5 build
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_HTTPD_MAX_URI_LEN=128
CONFIG_C6_AUDIO_BCLK_GPIO=9
CONFIG_C6_AUDIO_WS_GPIO=8
CONFIG_C6_AUDIO_DOUT_GPIO=7
CONFIG_C6_AUDIO_SD_GPIO=10

# Status LED: C5-as-master runs no receiver, so the C5-Zero onboard WS2812 on
# GPIO27 is free here (unlike the detector).
CONFIG_STATUS_LED_GPIO=27
