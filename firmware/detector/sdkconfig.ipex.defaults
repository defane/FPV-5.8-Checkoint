# detector-ipex overlay (on sdkconfig.defaults): a Waveshare ESP32-C5-Zero that listens
# on its IPEX connector, for an external antenna (hardware/antenna, or the enclosure's
# SMA bulkhead). GPIO 26 is driven high before the radio starts, so the boot calibration
# runs on the IPEX antenna. C5-Zero only: GPIO 26 is something else, or nothing, on other
# boards. With nothing on the IPEX connector the detector is deaf.
CONFIG_LETZTIMER_ANTENNA_IPEX=y
