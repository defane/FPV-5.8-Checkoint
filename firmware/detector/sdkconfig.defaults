# C5VRX-5: single-purpose MODEM_DIAG -> U85Q -> DAC receiver.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 4 MB: the Waveshare ESP32-C5-Zero has 4 MB flash. A 4 MB image also boots on
# an 8 MB part (only a size SMALLER than the header aborts), so this one binary
# runs on both. The partition table (partitions.csv) fits within 4 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Wi-Fi is only the RF front end (no traffic): its IRAM placement buys
# nothing, and that SRAM is the menu's DMA descriptor heap. The promiscuous
# filter is zero, so no frame is ever delivered: the minimum two static RX
# buffers (1.6 KiB each), two management buffers and no A-MPDU sessions
# return heap to the menu (2026-10-18: menu ESP_ERR_NO_MEM at 7 KiB free).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
# No PHY tracking timer: it would recalibrate RF during live video.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
CONFIG_PM_ENABLE=n
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
# The manual native-output observer runs with the PHY lease and needs no
# cache-disabled service. Preserve scarce SRAM for receiver task stacks.
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
# The standard image must also boot on boards without PSRAM. XIAO owners
# can select sdkconfig.psram.defaults on top of these defaults (README).
CONFIG_SPIRAM=n

# FPV 5.8 Checkpoint: sound only, no picture. The transport still runs with
# its exact timing; the DAC pins are routed to nothing and free for the
# amplifier (docs/CHECKPOINT.md). Delete sdkconfig after changing this.
CONFIG_C5VRX_VIDEO_OUTPUT=n

# Status LED: DISABLED on the detector. The C5-Zero's onboard WS2812 is wired to
# GPIO27, which is one of the receiver's IQ-loopback pins (RF_IQ_GPIO_NUMS in
# components/c5vrx_rx/rf.h) and is reserved for the C/N chain -- the receive
# chain comes first, so the onboard LED cannot be driven here. (The chip has no
# GPIO29 either; the Waveshare pinout's "GP29" is wrong.) The status LED lives
# on the node (C3-Zero, GPIO10) and master (C6-Zero, GPIO8) instead.
CONFIG_STATUS_LED_ENABLE=n
