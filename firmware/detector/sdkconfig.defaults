# FPV 5.8 Checkpoint detector (ESP32-C5): the sdr_rx engine (PHY I/Q dump snapshots, one LO per
# two channels), pass detection, UART link to the bridge. Settings partly after widscan58 a9fff97
# firmware/sdkconfig.defaults (itself derived from esp-sdr), GPL-3.0-or-later.
# Delete the generated sdkconfig* after editing: ESP-IDF never reapplies the defaults.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 4 MB: the Waveshare ESP32-C5-Zero has 4 MB flash; the image also boots on an 8 MB part.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Static RAM must end below the RF dump bank (0x40820000, components/sdr_rx/sram_guard.ld):
# -Os everywhere, -O2 in the hot components (sdr_rx, pass_detector CMakeLists).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# Wi-Fi only hosts the PHY (WIFI_MODE_NULL, promiscuous, no traffic): minimum buffers, no IRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
# PHY_DEBUG keeps the (experimental) ESP_PHY_DISABLE_PLL_TRACK switch reachable; tracking itself
# stays ON (spec 2.7). No cert-test archive: nothing in sdr_rx uses librftest.
CONFIG_ESP_PHY_DEBUG=y
CONFIG_PM_ENABLE=n
# The scan task is subscribed to the task watchdog (spec 5.3): a hung gate reboots (~2 s blind)
# instead of reporting stale levels. IDLE stays watched.
CONFIG_ESP_TASK_WDT_PANIC=y
# The standard image must boot on boards without PSRAM; the XIAO variant adds it.
CONFIG_SPIRAM=n
