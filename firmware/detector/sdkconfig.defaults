# C5VRX-5: single-purpose MODEM_DIAG -> U85Q -> DAC receiver.
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 4 MB: the Waveshare ESP32-C5-Zero has 4 MB flash. A 4 MB image also boots on
# an 8 MB part (only a size SMALLER than the header aborts), so this one binary
# runs on both. The partition table (partitions.csv) fits within 4 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Wi-Fi is only the RF front end (no traffic): its IRAM placement buys
# nothing, and that SRAM goes back to the heap. The promiscuous filter is
# zero, so no frame is ever delivered: the minimum two static RX buffers
# (1.6 KiB each), two management buffers and no A-MPDU sessions return heap
# too. (Upstream tuned this for its menu's DMA descriptor heap, 2026-10-18;
# the menu is pruned here but the RF front-end settings are kept as they are.)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_IEEE802154_ENABLED=n
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n
# No PHY tracking timer: it would recalibrate RF during live video.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
CONFIG_PM_ENABLE=n
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
# The manual native-output observer runs with the PHY lease and needs no
# cache-disabled service. Preserve scarce SRAM for receiver task stacks.
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=n
# The standard image must also boot on boards without PSRAM. XIAO owners
# can select sdkconfig.psram.defaults on top of these defaults (README).
CONFIG_SPIRAM=n

# FPV 5.8 Checkpoint: no picture. The transport still runs with its exact
# timing; the DAC pins are routed to nothing (docs/no-video-audio.md). The
# detector has no other local output either: no amplifier (the C6 master plays
# the sound) and no status LED (the C5-Zero's WS2812 is on GPIO27, a receiver
# IQ-loopback pin, RF_IQ_GPIO_NUMS in components/c5vrx_rx/rf.h; the chip has
# no GPIO29 either, the Waveshare pinout's "GP29" is wrong). Passes go out over
# the UART link. Delete sdkconfig after changing this.
CONFIG_C5VRX_VIDEO_OUTPUT=n

# The shared components dir (../../components) builds every component, also
# status_led and audio_player that nothing here calls. Keep them off anyway, so
# a stray call could never drive GPIO27 or an amplifier on a detector.
CONFIG_STATUS_LED_ENABLE=n
CONFIG_AUDIO_PLAYER_ENABLE=n
